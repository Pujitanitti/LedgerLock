# ── Ledger-Lock environment configuration ──────────────────────────────────
# Copy this file to .env and adjust values for local development.
# NEVER commit a real .env file. Values below are development-only defaults.

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- PostgreSQL ---
# Used by both docker-compose (to provision the container) and Prisma (to connect).
POSTGRES_USER=ledgerlock
POSTGRES_PASSWORD=dev_only_password_change_me
POSTGRES_DB=ledgerlock
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ledgerlock:dev_only_password_change_me@localhost:5432/ledgerlock?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API keys ---
# HMAC pepper used when hashing API-key secrets (see ADR-006). Rotate per environment.
# Generate a real value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_HMAC_PEPPER=dev_only_pepper_change_me_before_any_shared_use

# Optional: set this to the OUTGOING pepper value while rotating
# API_KEY_HMAC_PEPPER, so existing keys hashed under it still authenticate
# during the transition window (R-003). Remove this variable entirely once
# every real key has been re-issued or the window has safely elapsed —
# leaving it set indefinitely defeats the point of rotating in the first
# place. Never used when creating new keys, only when verifying existing ones.
# API_KEY_HMAC_PEPPER_PREVIOUS=

# --- Cache ---
AUTHZ_CACHE_TTL_SECONDS=60

# --- Audit ---
AUDIT_OUTBOX_FLUSH_INTERVAL_MS=250
AUDIT_OUTBOX_MAX_RETRIES=5
